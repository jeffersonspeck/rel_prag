@prefix epm: <https://example.org/epm/theseus#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

epm:TheseusOntology a owl:Ontology ;
    rdfs:label "Ship of Theseus stable ontology"@en ;
    rdfs:comment "Reference ontology containing only the ontologically anchored descriptor schema S(I)."@en .

epm:TheseusShip a epm:Ship ;
    rdfs:label "Ship of Theseus"@en ;
    rdfs:comment "Material instance used by independent systems over the same stable ontology."@en ;
    epm:hasDescriptor epm:p_float,
        epm:p_historical_value,
        epm:p_material,
        epm:p_monument_role,
        epm:p_origin,
        epm:p_structure .

epm:hasDescriptor a owl:ObjectProperty ;
    rdfs:domain epm:OntologicalInstance ;
    rdfs:range epm:Descriptor .

epm:DispositionDescriptor a owl:Class ;
    rdfs:label "Disposition descriptor"@en ;
    rdfs:comment "Descriptor concerning a realizable disposition."@en ;
    rdfs:subClassOf epm:Descriptor .

epm:MaterialEntity a owl:Class ;
    rdfs:label "Material entity"@en ;
    rdfs:comment "Domain class used for physical entities in this example."@en ;
    rdfs:subClassOf epm:OntologicalInstance ;
    skos:closeMatch <http://purl.obolibrary.org/obo/BFO_0000040> .

epm:PartDescriptor a owl:Class ;
    rdfs:label "Part descriptor"@en ;
    rdfs:comment "Descriptor concerning material parts or composition."@en ;
    rdfs:subClassOf epm:Descriptor .

epm:ProvenanceDescriptor a owl:Class ;
    rdfs:label "Provenance descriptor"@en ;
    rdfs:comment "Descriptor concerning origin or provenance."@en ;
    rdfs:subClassOf epm:Descriptor .

epm:QualityDescriptor a owl:Class ;
    rdfs:label "Quality descriptor"@en ;
    rdfs:comment "Descriptor concerning a quality of the entity."@en ;
    rdfs:subClassOf epm:Descriptor .

epm:RoleDescriptor a owl:Class ;
    rdfs:label "Role descriptor"@en ;
    rdfs:comment "Descriptor concerning a context-dependent role."@en ;
    rdfs:subClassOf epm:Descriptor .

epm:Ship a owl:Class ;
    rdfs:label "Ship"@en ;
    rdfs:comment "Material artifact capable of realizing navigation-related dispositions."@en ;
    rdfs:subClassOf epm:MaterialEntity .

epm:StructuralDescriptor a owl:Class ;
    rdfs:label "Structural descriptor"@en ;
    rdfs:comment "Descriptor concerning formal organization."@en ;
    rdfs:subClassOf epm:Descriptor .

epm:p_float a epm:DispositionDescriptor ;
    rdfs:label "Disposition to float and navigate"@en ;
    rdfs:comment "Realizable disposition related to floating and navigation."@en .

epm:p_historical_value a epm:QualityDescriptor ;
    rdfs:label "Historical value"@en ;
    rdfs:comment "Historical, symbolic, and memorial relevance."@en .

epm:p_material a epm:PartDescriptor ;
    rdfs:label "Material composition"@en ;
    rdfs:comment "Physical parts and material substrate of the ship."@en .

epm:p_monument_role a epm:RoleDescriptor ;
    rdfs:label "Monument role"@en ;
    rdfs:comment "Context-dependent role in preservation practices."@en .

epm:p_origin a epm:ProvenanceDescriptor ;
    rdfs:label "Origin and provenance"@en ;
    rdfs:comment "Origin, provenance, and historical continuity."@en .

epm:p_structure a epm:StructuralDescriptor ;
    rdfs:label "Structural organization"@en ;
    rdfs:comment "Formal configuration and organization of the ship."@en .

epm:OntologicalInstance a owl:Class ;
    rdfs:label "Ontological instance"@en ;
    rdfs:comment "Entity described by an ontology-grounded descriptor schema."@en .

epm:Descriptor a owl:Class ;
    rdfs:label "Typed descriptor"@en ;
    rdfs:comment "Ontology-grounded aspect available to the policy layer."@en .

